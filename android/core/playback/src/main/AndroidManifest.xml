<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The media notification on phones runs as a media playback foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Whether the network is metered, for the quality on mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Exported without a permission, as Media3 requires, so the system UI,
             Bluetooth and Assistant can connect to the media session. -->
        <service
            android:name="media.watchmy.client.core.playback.session.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The pictures on the launcher's Watch Next cards (PLAN-ANDROID-REVIEW.md §2.4).
             Exported so the launcher can read them; read-only, and it answers only
             addresses this app signed with a key that never leaves it (WatchNextArt),
             for the account signed in now. -->
        <provider
            android:name="media.watchmy.client.core.playback.watchnext.WatchNextArtProvider"
            android:authorities="${applicationId}.watchnext.art"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
