<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS discovery of servers on the local network (NsdManager). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17 blocks the local network (mDNS, .local names, LAN addresses) for apps
         targeting it unless this is granted; LocalNetworkGate asks for it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Live TV reminders on phones and tablets: notifications, asked
         at the first Remind me; and setting the reminders' alarms again after a reboot. The alarms
         are inexact (setWindow), so no exact-alarm permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- One APK for phones, tablets and TVs: neither touch nor leanback is required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Ethernet-only TVs must not be filtered out on Play. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- The TV's Trailer button hands YouTube trailers to the YouTube app, and shows only when an
         app can open a YouTube watch link: without this, Android 11 and
         later hide the YouTube app from resolveActivity. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
    </queries>

    <application
        android:name=".WatchMyMediaApp"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchMyMedia">

        <!-- Listed in both launchers; at launch it shows the TV or the phone UI. Compose takes
             these changes in place (LocalConfiguration, LocalDensity, the layout direction), so the
             activity is not recreated for them: a recreated activity ended the play and started
             the route's first file again, as a font size change during picture-in-picture did. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.WatchMyMedia.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Search, Live TV and Downloads on a long press of the phone launcher's icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- watchmymedia://play/{fileId}, watchmymedia://shows/{id}, watchmymedia://movies/{id}, watchmymedia://link?code=,
                 and the shortcuts' watchmymedia://search, watchmymedia://live and watchmymedia://downloads -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="watchmymedia" />
            </intent-filter>
            <!-- Cast Connect: a sender casting to this Android TV opens the app. -->
            <intent-filter>
                <action android:name="com.google.android.gms.cast.tv.action.LOAD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Casting from the phone. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="media.watchmy.client.CastOptionsProvider" />
        <!-- With CastOptions' setShowSystemOutputSwitcherOnCastIconClick, lets the Cast button open
             the system's Output Switcher on Android 17, where the in-app chooser finds no devices
             without local network access and the switcher needs none. -->
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" />
        <!-- Live TV reminders: the alarm's notification, and the alarms again after a reboot or an
             update. The boot receiver is off until LiveReminderAlarms keeps an alarm, and off again
             once it keeps none, so a boot starts the app only when there is something to set. -->
        <receiver
            android:name=".reminders.LiveReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.LiveReminderBoot"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- WorkManager starts the first time something uses it (the reminder and download syncs,
             the download service's scheduler, a job it set coming due), through WatchMyMediaApp's
             Configuration.Provider, not at every process start: its initializer was the costliest
             in androidx.startup's provider, about 7-23 ms on the main thread before
             Application.onCreate on an emulator (StartupBenchmark). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        <!-- Casting to the TV app (Cast Connect). -->
        <meta-data
            android:name="com.google.android.gms.cast.tv.RECEIVER_OPTIONS_PROVIDER_CLASS_NAME"
            android:value="media.watchmy.client.CastReceiverOptionsProvider" />
    </application>
</manifest>
