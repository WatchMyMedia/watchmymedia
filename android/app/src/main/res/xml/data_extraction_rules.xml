<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The DataStore holds this device's random ID and its sign-ins, sealed with
     a Keystore key that never leaves the device: restoring it elsewhere would give two
     devices one ID and tokens that can't be opened. Downloads (noBackupFilesDir/offline, never
     backed up) are listed in Media3's database, which would be wrong without them. The
     SharedPreferences are about this device too: a declined local network question
     (local_network), which on a new phone would keep it from being asked; this phone's
     reminder alarms (live-tv-reminders); and the decoders that failed on this system build
     (playback_profile). Nothing else is worth keeping. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
