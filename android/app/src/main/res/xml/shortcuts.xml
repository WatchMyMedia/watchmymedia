<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's shortcuts on a phone or tablet (PLAN-ANDROID-REVIEW §6.3): long-press the
     icon for Search, Live TV and Downloads. Each opens a watchmymedia:// link, which waits
     through the server picker and sign-in as any link does. TV launchers don't show them. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="watchmymedia://search"
            android:targetClass="media.watchmy.client.MainActivity"
            android:targetPackage="@string/shortcut_package" />
    </shortcut>
    <shortcut
        android:shortcutId="live_tv"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_live_tv"
        android:shortcutShortLabel="@string/shortcut_live_tv">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="watchmymedia://live"
            android:targetClass="media.watchmy.client.MainActivity"
            android:targetPackage="@string/shortcut_package" />
    </shortcut>
    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="watchmymedia://downloads"
            android:targetClass="media.watchmy.client.MainActivity"
            android:targetPackage="@string/shortcut_package" />
    </shortcut>
</shortcuts>
