<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Apple TV app: the App Group it shares with its Top Shelf extension
     (apple/TopShelf), where it writes the shelf's snapshot and pictures
     (Kit/Sources/WMMTopShelf). The sign-in stays in the app's own Keychain. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.media.watchmy.client</string>
	</array>
</dict>
</plist>
