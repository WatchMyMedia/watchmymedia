<?xml version="1.0" encoding="UTF-8"?>
<!-- The store identity, chosen 2026-11-20: never change the widget id, the package id or the application id. Every store update must keep them and be signed with the same Samsung author certificate. Raise the version for each update, together with TV_APP_VERSION in session/device.ts. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://watchmy.media/tizen" version="2.3.0" viewmodes="maximized">
  <tizen:application id="cPFf0iV3Li.WatchMyMedia" package="cPFf0iV3Li" required_version="8.0"/>
  <name>WatchMyMedia</name>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <tizen:profile name="tv-samsung"/>
  <!-- Samsung's pre-test checks the screen size the app declares: a 1080p TV app, as in Samsung's templates. -->
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <!-- The TV's model and firmware for Settings › About and the signed-in devices list (productinfo refused them without it). -->
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/use.network" value="true"/>
  <access origin="*" subdomains="true"/>
  <!-- Tizen loads an outside page, in an iframe too, only where allow-navigation names it: YouTube trailers. -->
  <tizen:allow-navigation>www.youtube-nocookie.com www.youtube.com</tizen:allow-navigation>
  <tizen:content-security-policy>default-src 'self'; script-src 'self' $WEBAPIS; style-src 'self' 'unsafe-inline'; connect-src http: https:; media-src http: https: blob:; img-src 'self' data: blob: http: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'self'; base-uri 'self'</tizen:content-security-policy>
</widget>
