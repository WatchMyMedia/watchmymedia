// The Google Cast receiver at https://cast.watchmy.media (PLAN-CAST.md §4):
// the static files `pnpm build:receiver` writes to dist-receiver/, served by
// a Worker with no code of its own. Its _headers file (receiver/public/)
// sets the receiver's CSP. The custom domain makes Cloudflare create the DNS
// record and certificate on deploy. Deploy with `pnpm deploy:receiver`.
{
  "name": "watchmymedia-cast",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./dist-receiver" },
  "routes": [{ "pattern": "cast.watchmy.media", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
