# build outputs
/bin/
/build/
/dist/
/macos/.build/
/web/dist/
/web/dist-receiver/
/web/dist-tizen/
*.wgt
/server/tmp/
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep
# wrangler's local state (deploy/downloads, the Cast receiver) and Python's caches
.wrangler/
__pycache__/

# runtime data (database, artwork cache, transcode segments)
/data/
*.db
*.db-wal
*.db-shm

# dependencies
/web/node_modules/

# agent sessions: their worktrees, per-person settings, and server logs they leave
/.claude/worktrees/
/.claude/settings.local.json
/server.log

# tool caches: TypeScript's incremental build, Xcode's package settings
*.tsbuildinfo
.swiftpm/

# local env / editors / OS
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# signing and notarisation files (App Store Connect keys, exported identities, downloaded certificates)
*.p8
*.p12
*.cer
*.certSigningRequest

# Private key exports and local launch settings must not enter a public repo.
*.pem
*.key
*.pfx
*.jks
*.keystore
/.claude/launch.json

# Windows resources are generated by windows/build.sh into each executable package.
/windows/cmd/tray/rsrc_windows_*.syso
/server/cmd/server/rsrc_windows_*.syso
