# Copy to deploy/.env and edit. Git ignores deploy/.env.
# Compose uses these for the port and volume lines, and passes every line
# into the container, so any WATCHMYMEDIA_* setting can go here too.

# Your library folders on this machine. Both are required by compose.
# With movies only, set TV_DIR to an existing empty folder; with TV only,
# set MOVIES_DIR to an existing empty folder. Empty folders seed no library.
MOVIES_DIR=/path/to/Movies
TV_DIR=/path/to/TV

# Your host user, so the container can read the folders:  id -u ; id -g
# (macOS is usually 501 and 20.)
PUID=1000
PGID=1000
TZ=UTC

# 0.0.0.0 serves the whole network. 127.0.0.1 accepts connections only from
# this machine, which is what you want behind Tailscale Serve.
WATCHMYMEDIA_BIND=0.0.0.0
WATCHMYMEDIA_HOST_PORT=27587

# Set to true when you reach the server over HTTPS (Tailscale Serve or
# another reverse proxy). Plain http:// sign-ins stop working once it is on.
WATCHMYMEDIA_AUTH_SECURE_COOKIES=false

# WATCHMYMEDIA_TMDB_API_KEY=

# Admin settings and first-run setup only work from these networks:
# "local" (loopback, private LAN, Tailscale), CIDR ranges, or "any".
# WATCHMYMEDIA_ADMIN_NETWORKS=local

# Reverse proxies whose X-Forwarded-For header is believed (addresses or
# CIDR ranges). docker-compose.proxy.yml sets this for its Caddy container.
# WATCHMYMEDIA_TRUSTED_PROXIES=

# Public access with docker-compose.proxy.yml or proxy-macos.yml: the name
# that points at your home IP, and the compose network's fixed subnet.
# Change the subnet only if it clashes with your LAN or a VPN; keep the
# other two addresses inside it (Caddy's address on Linux, the gateway on
# macOS).
# WATCHMYMEDIA_DOMAIN=home.watchmy.media
# WATCHMYMEDIA_PROXY_SUBNET=10.87.250.0/24
# WATCHMYMEDIA_PROXY_IP=10.87.250.10
# WATCHMYMEDIA_PROXY_GATEWAY=10.87.250.1

# Public access through an existing SWAG container (docker-compose.swag.yml):
# the Docker network SWAG is on and SWAG's address on it (README, "With SWAG").
# WATCHMYMEDIA_SWAG_NETWORK=swag_default
# WATCHMYMEDIA_SWAG_PROXY_IP=172.18.0.2
